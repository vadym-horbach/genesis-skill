<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t("title") }}</title>
<style>
  :root { --fg:#1d232b; --muted:#5b6571; --line:#dde2e8; --accent:#2a6fdb; --bg:#ffffff; --warn:#8a5a00; }
  * { box-sizing:border-box; }
  body { margin:0 auto; max-width:190mm; padding:10mm 8mm; font:12px/1.4 -apple-system,"Segoe UI",Roboto,sans-serif; color:var(--fg); background:var(--bg); }
  h1 { font-size:18px; margin:0 0 4px; }
  h2 { font-size:13px; margin:12px 0 4px; border-bottom:1px solid var(--line); padding-bottom:2px; }
  .muted { color:var(--muted); }
  table { width:100%; border-collapse:collapse; font-size:11px; }
  th, td { text-align:left; padding:3px 4px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-weight:600; }
  .num { text-align:right; font-variant-numeric:tabular-nums; }
  .label { font-weight:600; }
  .pareto { color:var(--accent); }
  img { width:100%; height:auto; }
  ul { margin:2px 0 0 16px; padding:0; }
  li { margin:1px 0; }
  .warn li { color:var(--warn); }
  .analysis { border-left:3px solid var(--accent); padding:2px 0 2px 8px; margin:6px 0; }
  .headline { font-size:13px; font-weight:600; margin:0 0 4px; }
  h3 { font-size:11px; margin:6px 0 2px; }
  footer { margin-top:8px; font-size:10px; color:var(--muted); }
  @media print {
    @page { size:A4; margin:8mm; }
    body { padding:0; max-width:none; font-size:10px; }
    h2 { margin-top:6px; }
  }
</style>
</head>
<body>
<h1>{{ t("title") }}</h1>

{% if analysis %}
<h2>{{ t("analysis") }}</h2>
<div class="analysis">
  <p class="headline">{{ analysis.headline }}</p>
  <h3>{{ t("findings") }}</h3>
  <ul>{% for f in analysis.findings %}<li>{{ f }}</li>{% endfor %}</ul>
  <h3>{{ t("recommendation") }}</h3>
  <div>{{ analysis.recommendation }}</div>
  {% if analysis.next_steps %}
  <h3>{{ t("next_steps") }}</h3>
  <ul>{% for s in analysis.next_steps %}<li>{{ s }}</li>{% endfor %}</ul>
  {% endif %}
</div>
{% endif %}

<h2>{{ t("scope") }}</h2>
<div>{{ scope_period }} {{ t("scope_traffic") }}</div>
<ul>
{% for tp in topics %}
  <li><b>{{ tp.name }}</b>: {{ tp.cluster | join(", ") }}
    {% if tp.auto_selected %}<span class="muted">({{ t("auto_selected") }})</span>{% endif %}
    {% if tp.missing %}<span class="muted">{{ t("no_article", projects=tp.missing | join(", ")) }}</span>{% endif %}
  </li>
{% endfor %}
</ul>

<h2>{{ t("comparison") }}</h2>
<table>
  <tr><th>{{ t("col_topic") }}</th><th>{{ t("col_edition") }}</th><th class="num">{{ t("col_views") }}</th>
      <th class="num">{{ t("col_per_million") }}</th><th class="num">{{ t("col_yoy") }}</th>
      <th class="num">{{ t("col_yoy_raw") }}</th><th class="num">{{ t("col_trend") }}</th>
      <th class="num">{{ t("col_rising") }}</th><th class="num">{{ t("col_spikes") }}</th>
      <th>{{ t("col_evidence") }}</th><th>{{ t("col_label") }}</th>
      {% if r.comparison.weighted %}<th class="num">{{ t("col_score") }}</th>{% endif %}</tr>
  {% for row in rows %}
  <tr>
    <td>{{ row.topic }}</td><td>{{ row.project }}{% if row.pareto %} <span class="pareto">●</span>{% endif %}</td>
    <td class="num">{{ row.scale }}</td><td class="num">{{ row.relative }}</td>
    <td class="num">{{ row.yoy }}</td><td class="num">{{ row.yoy_raw }}</td><td class="num">{{ row.trend }}</td>
    <td class="num">{{ row.consistency }}</td><td class="num">{{ row.spikes }}</td>
    <td>{{ row.evidence }}</td><td class="label">{{ row.label }}</td>
    {% if r.comparison.weighted %}<td class="num">{{ row.score }}</td>{% endif %}
  </tr>
  {% endfor %}
</table>
<div class="muted">{{ t("pareto_note") }}{% if score_note %} {{ score_note }}{% endif %}</div>

<h2>{{ t("charts") }}</h2>
<img src="{{ charts.relative_attention }}" alt="{{ t('chart_relative') }}">
<img src="{{ charts.raw_views }}" alt="{{ t('charts') }}">

{% if has_details %}
<h2>{{ t("details") }}</h2>
<ul>
{% for row in rows if row.detail %}<li><b>{{ row.topic }}, {{ row.project }}:</b> {{ row.detail }}</li>{% endfor %}
</ul>
{% endif %}

<h2>{{ t("warnings") }}</h2>
<ul class="warn">
{% for w in warnings %}<li>{{ w }}</li>{% else %}<li class="muted">{{ t("none") }}</li>{% endfor %}
{% if warnings_truncated %}<li class="muted">{{ t("more_warnings", count=warnings_truncated) }}</li>{% endif %}
</ul>

<h2>{{ t("limitations") }}</h2>
<ul>{% for x in limitations %}<li>{{ x }}</li>{% endfor %}</ul>

<footer>{{ footer }}</footer>
</body>
</html>
